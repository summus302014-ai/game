# Настройки HEXWORLD. Скопируйте этот файл в ".env" и впишите свой ключ.
# Строки, начинающиеся с #, игнорируются. Кавычки вокруг значений не нужны.

# --- ВАРИАНТ 1: Claude (Anthropic) --- ключ: platform.claude.com -> Settings -> API keys
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=

# --- ВАРИАНТ 2: Gemini (Google) --- ключ: aistudio.google.com
# Закомментируйте строки варианта 1 выше (поставьте # в начале) и уберите # здесь:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_CHAT_PATH=/chat/completions
# LLM_MODEL=gemini-3.6-flash
# LLM_API_KEY=

# --- Необязательно ---
# PORT=3000
# LLM_MIN_INTERVAL_MS=1500
# OPEN_BROWSER=0
